# 视频批处理工具 (VideoBatchStudio) - 环境变量示例配置
# 请复制本文件并重命名为 .env 使用，切勿将包含真实密钥的文件提交到版本控制库！

# ElevenLabs 语音服务 API 密钥 (如使用 ElevenLabs TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Gladia 智能转写 / 辅助字幕 API 密钥 (可选)
GLADIA_API_KEY=your_gladia_api_key_here

# 代理服务器设置 (如需要科学下载模型或访问外部 API，例如 http://127.0.0.1:7890)
HTTP_PROXY=
HTTPS_PROXY=
